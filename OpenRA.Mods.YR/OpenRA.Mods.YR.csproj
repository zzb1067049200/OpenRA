<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>OpenRA.Mods.YR</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <LangVersion>latest</LangVersion>
    <DebugSymbols>true</DebugSymbols>
    <!-- Porting to the current engine: do not fail the build on style warnings yet. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <OutputPath>../mods/yr</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- OutputPath is a source-controlled mod folder, so don't scatter the engine's
         dependency DLLs (SDL2-CS, Eluant, ...) next to the mod yaml: they are already
         present in the engine's bin dir, and on Android they would be bundled into
         assets/mods/yr by the OpenRA.Android AndroidAsset glob. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- Match the engine: when building for Android, switch to the android TFM so
       OperatingSystem.IsAndroid() and the android BCL surface are available, and the
       referenced engine projects (which also switch on this flag) line up. -->
  <PropertyGroup Condition="'$(BuildForAndroid)' == 'true'">
    <TargetFramework>net10.0-android</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Work around an issue where Rider does not detect files in the project root using the default glob -->
    <Compile Include="**/*.cs" Exclude="$(DefaultItemExcludes)" />
    <!-- UtilityCommands are dev-only console commands (map/translation import) and are not
         referenced by any mod.yaml; NewMissionBrowserLogic is dead code (no yaml references it).
         Both are excluded until the rest of the mod is ported. -->
    <Compile Remove="UtilityCommands/**/*.cs" />
    <Compile Remove="Widgets/Logic/NewMissionBrowserLogic.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OpenRA.Game/OpenRA.Game.csproj">
      <Private>False</Private>
    </ProjectReference>
    <ProjectReference Include="../OpenRA.Mods.Cnc/OpenRA.Mods.Cnc.csproj">
      <Private>False</Private>
    </ProjectReference>
    <ProjectReference Include="../OpenRA.Mods.Common/OpenRA.Mods.Common.csproj">
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
	<!-- When building for Android (-p:BuildForAndroid=true), switch to the android TFM so this
	     mod assembly is compatible with the android-built OpenRA.Game. Desktop builds keep net10.0. -->
	<PropertyGroup Condition="'$(BuildForAndroid)' == 'true'">
		<TargetFramework>net10.0-android</TargetFramework>
	</PropertyGroup>
	<PropertyGroup>
		<IsPublishable Condition="'$(CopyD2kDll)' == 'False'">false</IsPublishable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\OpenRA.Game\OpenRA.Game.csproj">
			<Private>False</Private>
		</ProjectReference>
		<ProjectReference Include="..\OpenRA.Mods.Common\OpenRA.Mods.Common.csproj">
			<Private>False</Private>
		</ProjectReference>
	</ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- 关键:Microsoft.NET.Sdk + net10.0-android 虽会导入 Android 构建目标(故 AOT 能跑),
         但不会自动把 $(AndroidApplication) 置 true,导致 _BuildApk 打包目标被闸住、永不产包。
          Sdk="Microsoft.Android.Sdk" 在本 CI 又因 workload 只装了 runtime pack 而解析失败,
         故这里显式置 true,让 dotnet publish 真正走 _BuildApk+签名出 .apk。 -->
    <AndroidApplication>true</AndroidApplication>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AndroidPackageName>com.openra.android</AndroidPackageName>
    <AndroidVersionCode>1</AndroidVersionCode>
    <AndroidVersionName>0.1.0</AndroidVersionName>
    <AndroidManifest>Properties/AndroidManifest.xml</AndroidManifest>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <!-- Phase 1：先证明工具链可编译，关掉 AOT/链接加快迭代；后续再收紧 -->
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidLinkMode>None</AndroidLinkMode>
    <AndroidUseAapt2>true</AndroidUseAapt2>
    <!-- minSdk / targetSdk 以 csproj 为准，manifest 不再手写 uses-sdk，避免两处打架 -->
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <TargetSdkVersion>36</TargetSdkVersion>
    <!-- Release 默认只出 .aab；显式要 apk 才能被 CI 的 upload-artifact (*.apk) 抓到并 sideload 测试 -->
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <!-- CI 上由 ANDROID_HOME / JAVA_HOME 自动解析，不硬编码本机路径 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- 引擎核心 + 默认平台后端（SDL2/OpenAL/FreeType，SDL2-CS 已带 android 原生库） -->
    <ProjectReference Include="..\OpenRA.Game\OpenRA.Game.csproj" />
    <ProjectReference Include="..\OpenRA.Platforms.Default\OpenRA.Platforms.Default.csproj" />
    <!-- 内置 mod（ra/cnc/d2k）；YR 在 Phase 5 接入 -->
    <ProjectReference Include="..\OpenRA.Mods.Common\OpenRA.Mods.Common.csproj" />
    <ProjectReference Include="..\OpenRA.Mods.Cnc\OpenRA.Mods.Cnc.csproj" />
    <ProjectReference Include="..\OpenRA.Mods.D2k\OpenRA.Mods.D2k.csproj" />
  </ItemGroup>
</Project>

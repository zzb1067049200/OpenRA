<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <AndroidApplication>true</AndroidApplication>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AndroidPackageName>com.openra.android</AndroidPackageName>
    <AndroidVersionCode>1</AndroidVersionCode>
    <AndroidVersionName>0.1.0</AndroidVersionName>
    <AndroidManifest>Properties/AndroidManifest.xml</AndroidManifest>
    <!-- Phase 2: net10 + EGL backend (OpenRA.Platforms.Android). Linking kept off for
         faster/lower-risk builds; tighten later. -->
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- AOT off: Release net10.0-android AOT-compiles System.Private.CoreLib with the SDK
         cross-compiler, and when that image's instance_size disagrees with the libmonosgen
         runtime bundled in the APK Mono aborts at startup (class-init.c:2474
         'klass->instance_size == instance_size'). Interpreter/JIT avoids the pre-baked image
         entirely. Re-enable once SDK + Android workload are pinned to a matching pair. -->
    <RunAotCompilation>false</RunAotCompilation>
    <AndroidLinkMode>None</AndroidLinkMode>
    <AndroidUseAapt2>true</AndroidUseAapt2>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <TargetSdkVersion>36</TargetSdkVersion>
    <!-- Release default only emits .aab; force .apk so CI can sideload-test. -->
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <!-- Deliberately OFF. Setting this to true ships libmono-android.debug.so, and that
         runtime aborts at startup on a normally sideloaded APK: it looks for assemblies
         under files/.__override__/arm64-v8a, finds none, assumes a Fast Deployment bundle
         and kills the process before MainActivity runs. Debug symbols are injected into
         the package by tools/yr-port/inject_pdb_into_apk.py instead, which keeps the
         managed stack traces useful without swapping in the debug runtime. -->
    <AndroidIncludeDebugSymbols>false</AndroidIncludeDebugSymbols>
    <AndroidManagedSymbols>true</AndroidManagedSymbols>
  </PropertyGroup>

  <!-- Local Windows build override. The git-bash shell rewrites D:\... into D://... when
       exporting JAVA_HOME/ANDROID_HOME, so dotnet's own JDK/SDK probes fail with
       "Could not find required file `jar`" / XA5300 / MSB4181. Pinning the paths here
       (only when they exist on this machine) sidesteps the environment entirely; CI sets
       its own JAVA_HOME/ANDROID_HOME and is unaffected because these dirs do not exist there.

       KNOWN ISSUE (2026-10-04): this override does NOT work. Even with the paths pinned here,
       the build still reports XA5300 + "Value cannot be null (Parameter 'path1')" + XA0034 and
       then MSB4181 ValidateJavaVersion=false. Verified that Xamarin.Android.Tooling.targets
       line 61/63 genuinely reads $(AndroidSdkDirectory)/$(JavaSdkDirectory), so the PropertyGroup
       below is not being evaluated before the tooling targets consume it. Exports with
       forward-slash JAVA_HOME/ANDROID_HOME failed identically. Local Android builds are
       currently blocked by the sandbox's dotnet-block; CI (ubuntu-latest) is the working path.
       Kept for reference until the real evaluation-order bug is understood. -->

  <ItemGroup>
    <!-- EGL/GLES direct-render backend (no SDL2). Drop OpenRA.Platforms.Default — it pulls
         SDL2 which has no Android native lib and is unused on this path. -->
    <ProjectReference Include="..\OpenRA.Platforms.Android\OpenRA.Platforms.Android.csproj" />
    <!-- Engine core + built-in mods (ra / cnc / d2k) + Yuri's Revenge (yr).
         ObjectCreator.LoadCompiledInAssembly resolves mod assemblies by name on Android, so
         every mod that ships a custom DLL must be a ProjectReference here. -->
    <ProjectReference Include="..\OpenRA.Game\OpenRA.Game.csproj" />
    <ProjectReference Include="..\OpenRA.Mods.Common\OpenRA.Mods.Common.csproj" />
    <ProjectReference Include="..\OpenRA.Mods.Cnc\OpenRA.Mods.Cnc.csproj" />
    <ProjectReference Include="..\OpenRA.Mods.D2k\OpenRA.Mods.D2k.csproj" />
    <ProjectReference Include="..\OpenRA.Mods.YR\OpenRA.Mods.YR.csproj" />
  </ItemGroup>

  <!-- Engine assets shipped inside the APK. The Activity extracts these to internal storage on
       first launch and points Platform.EngineDir there. -->
  <ItemGroup>
    <AndroidAsset Include="..\glsl\**\*.vert" Link="assets\glsl\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\glsl\**\*.frag" Link="assets\glsl\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\VERSION" Link="assets\VERSION" />
    <!-- The global mix database is needed to resolve filenames inside C&amp;C .mix archives. -->
    <AndroidAsset Include="..\global mix database.dat" Link="assets\global mix database.dat" />
    <!-- Only the yaml/script asset trees of the built-in mods + shared 'common' mod.
         Game asset packages (mix files) are NOT bundled; the menu + asset-installer screen work
         without them, and users add real game content via scoped storage later. -->
    <AndroidAsset Include="..\mods\common\**\*.*" Link="assets\mods\common\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\mods\common-content\**\*.*" Link="assets\mods\common-content\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\mods\ra\**\*.*" Link="assets\mods\ra\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\mods\ra-content\**\*.*" Link="assets\mods\ra-content\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\mods\cnc\**\*.*" Link="assets\mods\cnc\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\mods\cnc-content\**\*.*" Link="assets\mods\cnc-content\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\mods\d2k\**\*.*" Link="assets\mods\d2k\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\mods\d2k-content\**\*.*" Link="assets\mods\d2k-content\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\mods\ts\**\*.*" Link="assets\mods\ts\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\mods\ts-content\**\*.*" Link="assets\mods\ts-content\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Yuri's Revenge mod assets (yaml + bits). RA2/YR game .mix files are user-supplied, not bundled. -->
    <AndroidAsset Include="..\mods\yr\**\*.*" Link="assets\mods\yr\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\mods\all\**\*.*" Link="assets\mods\all\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Pre-baked free game content (OpenRA CDN, GPL-compatible). Populated by the CI "Bake free
         content packages" step (and optionally by a local script) so the APK ships with ra/cnc/d2k
         assets and the mods launch without the in-app downloader. MainActivity extracts these to the
         support dir on first engine start. -->
    <AndroidAsset Include="Assets\openra-content\**\*" />
  </ItemGroup>

  <!-- Native libraries built from source with the NDK (thirdparty/build-*-android.sh).
       These must live in the app project: AndroidNativeLibrary only propagates from an
       application project, not from a referenced library. The includes are conditional so
       that a from-source build still compiles when jniLibs is not yet populated (e.g. when CI
       builds the .so files first). -->
  <ItemGroup Condition="Exists('jniLibs/arm64-v8a/libfreetype6.so')">
    <AndroidNativeLibrary Include="jniLibs/arm64-v8a/libfreetype6.so" />
  </ItemGroup>
  <ItemGroup Condition="Exists('jniLibs/arm64-v8a/libfreetype.so')">
    <AndroidNativeLibrary Include="jniLibs/arm64-v8a/libfreetype.so" />
  </ItemGroup>
  <ItemGroup Condition="Exists('jniLibs/arm64-v8a/liblua51.so')">
    <AndroidNativeLibrary Include="jniLibs/arm64-v8a/liblua51.so" />
  </ItemGroup>
  <ItemGroup Condition="Exists('jniLibs/arm64-v8a/libsoft_oal.so')">
    <AndroidNativeLibrary Include="jniLibs/arm64-v8a/libsoft_oal.so" />
  </ItemGroup>
</Project>

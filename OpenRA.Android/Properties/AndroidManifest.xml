<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          android:versionCode="1"
          android:versionName="0.1.0"
          package="com.openra.android">

  <!-- 联网（多人/地图下载）、读取自备资源、OpenGL ES 3.0 -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
  <uses-feature android:glEsVersion="0x00030000" android:required="true" />

  <!-- The <activity> for OpenRA.Android.MainActivity is generated from the [Activity] attribute
       in MainActivity.cs (MainLauncher=true). Declaring it here too would duplicate-register it,
       so we leave the application element empty and let the attribute-driven manifest merge add it. -->
  <application android:label="OpenRA"
               android:icon="@android:drawable/ic_menu_gallery"
               android:hasCode="true"
               android:debuggable="false">
  </application>
</manifest>
